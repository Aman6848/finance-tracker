{
  "info": {
    "_postman_id": "3c9274a6-4a8f-41e6-934f-f290d8b6cc6f",
    "name": "Finance Tracker",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for testing expense APIs in the finance-tracker project."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Expense",
      "description": "Requests for expense creation and listing.",
      "item": [
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Groceries\",\n  \"amount\": 249.75,\n  \"category\": \"Food\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "Creates a new expense. `title` and `amount` are required by validation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Created expense contains generated fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.exist;",
                  "    pm.expect(jsonData.title).to.eql(\"Groceries\");",
                  "    pm.expect(jsonData.amount).to.eql(249.75);",
                  "    pm.expect(jsonData.createdAt).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get All Expenses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "Returns all expenses from the database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Expenses By Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/category/Food",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "category",
                "Food"
              ]
            },
            "description": "Returns all expenses for the given category."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Total Expenses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/total",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "total"
              ]
            },
            "description": "Returns the sum of all expense amounts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is a number\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Monthly Groceries\",\n  \"amount\": 315.5,\n  \"category\": \"Food\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expenses/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "1"
              ]
            },
            "description": "Updates an expense by id and returns the updated object. Returns 404 if the expense does not exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Updated expense is returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(1);",
                  "    pm.expect(jsonData.title).to.eql(\"Monthly Groceries\");",
                  "    pm.expect(jsonData.amount).to.eql(315.5);",
                  "    pm.expect(jsonData.category).to.eql(\"Food\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "1"
              ]
            },
            "description": "Deletes an expense by id and returns a success message. Returns 404 if the expense does not exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Success message is returned\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"Expense deleted successfully\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
